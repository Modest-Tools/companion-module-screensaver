{
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules/**", "src/**/*spec.ts", "src/**/__tests__/*"],
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": "./src",
		"target": "es2022",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"sourceMap": true,
		"declaration": false,
		"verbatimModuleSyntax": true,
		"resolveJsonModule": true,
		"types": ["node"]
	}
}
